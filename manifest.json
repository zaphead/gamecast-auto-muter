{
  "manifest_version": 3,
  "name": "GameCast Auto-Muter",
  "version": "0.3.0",
  "description": "Watches this tab, mutes full-screen ads, unmutes the game.",
  "permissions": ["tabs", "storage", "offscreen", "activeTab", "tabCapture"],
  "host_permissions": ["https://api.openai.com/*", "<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GameCast Auto-Muter"
  }
}
